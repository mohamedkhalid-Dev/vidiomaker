# --- Vidiomaker frontend (.env.example — SAFE to commit; never commit real .env.local) ---
# Deploy: frontend-only on Vercel. All API calls use same-origin relative /api/* routes.
# Copy to .env.local and fill in real values (see README.md "Environment variables").

# --- Public: browser-safe, NEXT_PUBLIC_ prefix required for client access ---
# Supabase project URL + publishable (anon) key. Used client-side in
# src/lib/supabase.ts (isSupabaseConfigured() guards when empty).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only: Next.js Route Handlers under src/app/api/* — NEVER prefix with NEXT_PUBLIC_ ---
# Optional server fallback for Route Handlers (per-user key from Settings UI
# takes precedence, sent as Authorization Bearer header — never in URLs/logs).
OPENROUTER_API_KEY=
# Cloudflare Workers AI image generation (POST /api/generate-image proxy).
# Get them at dash.cloudflare.com → Workers AI → Use REST API →
# Create a Workers AI API Token (needs Workers AI Read + Edit) + copy Account ID.
# Both are REQUIRED for Generate images (4 selectable FLUX models).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Server-only key for privileged Storage/DB writes from Route Handlers.
# Never import this in client components — build will expose it otherwise.
SUPABASE_SERVICE_ROLE_KEY=
